<Defs>
  <AlienRace.ThingDef_AlienRace ParentName="Human">
    <defName>WC_Cat</defName>
    <label>warrior cat</label>
    <description>A Clan cat. Fierce, loyal, born to the wild.</description>

    <race>
      <body>Cat</body>
      <baseBodySize>0.5</baseBodySize>
      <baseHealthScale>0.7</baseHealthScale>
      <baseHungerRate>0.7</baseHungerRate>
    </race>

    <alienRace>
      <generalSettings>
        <alienPartGenerator>
          <!-- One entry per BodyTypeDef. HAR rolls one at spawn = breed variety. -->
          <bodyTypes>
            <li>Cat</li>
            <li>CatSiamese</li>
          </bodyTypes>

          <!-- Variant A: <li>Cat_head</li>   |   Variant B: <li>WC_Blank</li> -->
          <headTypes><li>Cat_head</li></headTypes>

          <headOffsetDirectional>
            <north><offset>(0, 0.1)</offset></north>
            <south><offset>(0, 0.1)</offset></south>
            <east><offset>(0.1, 0.1)</offset></east>
            <west><offset>(-0.1, 0.1)</offset></west>
          </headOffsetDirectional>
        </alienPartGenerator>
      </generalSettings>

      <graphicPaths>
        <body>Things/Pawn/Animal/Cat/</body>
        <head>Things/Pawn/Animal/Cat/</head>
        <skinShader>Cutout</skinShader>
      </graphicPaths>

      <!-- Ban apparel: animal sprites have no _naked variant. Verify field names
           against the HAR wiki "Race Restriction" page. -->
      <raceRestriction>
        <apparelList />
      </raceRestriction>
    </alienRace>
  </AlienRace.ThingDef_AlienRace>
</Defs>
